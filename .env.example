# Copy to the project root .env. Never commit the real key.
# Used only for audio (explicit Ask Axo Live voice); all reasoning uses local Codex.
OPENAI_API_KEY=

# Optional Argus launch-event feed through Bitquery.
AXO_BITQUERY_ACCESS_TOKEN=

# Optional absolute path when the Codex CLI is not available on PATH.
# AXO_CODEX_PATH=

# Exact HTTPS origin served by your reverse proxy. No trailing slash or path.
# Local loopback access remains supported alongside this origin.
AXO_PUBLIC_ORIGIN=https://streams.axo.vision

# Exact EVM administrator. Unset uses the AXO controller wallet.
AXO_ADMIN_WALLET=
# Optional private persistent directory for managed admin settings and voice key.
# AXO_ADMIN_DIR=

# Optional isolated AXO Streams peer-auth database; all three values required.
# No password, TCP connection string or shared cluster. Migrate before enabling.
AXO_STREAMS_DB_SOCKET=/run/axo-streams-postgres
AXO_STREAMS_DB_NAME=axo_streams
AXO_STREAMS_DB_ROLE=axostreams

# Optional operator-owned private account history directory. No browser uploads.
# Leave unset until exact-wallet transaction classification and reward receipts are verified.
# AXO_ACCOUNT_HISTORY_DIR=/var/lib/axo-streams/private/account-history

# Optional exact 40-character deployment commit when this installation has no .git directory.
# A clean build manifest from pnpm run build:release is preferable.
# AXO_RELEASE_COMMIT=

# Optional secretless Ed25519 coordination client; no bearer token is used.
# Configure the protected key-file path only on the enrolled Builder host.
# AXO_COORDINATION_ENDPOINT=https://claw.supah.ai/api/coordination/v1/messages
# AXO_COORDINATION_PRIVATE_KEY_FILE=/protected/runtime/path/builder-ed25519.pem

# Optional Builder preview fallback: exact, public project observations only.
# Leave unset on the live origin itself; never insert private DB credentials here.
# AXO_SHARED_KNOWLEDGE_ORIGIN=https://streams.axo.vision

# Optional explicit migration of an existing ENABLED paper run to background strategies.
# Does not start a new run, resume a paused run, clear history or enable real orders.
# AXO_PAPER_ENGINE=strategies

# Optional official read-only GMGN Agent API. Off by default; no swap/signing key.
# Verify your GMGN account terms and quota before opting in. No API account is created here.
# AXO_GMGN_DATA_ENABLED=1
# GMGN_API_KEY=
# Optional installed Playwright browser channel for explicit public-page research.
# Windows defaults to Chrome; Linux uses the installed Playwright Chromium.
# AXO_BROWSER_CHANNEL=chrome
